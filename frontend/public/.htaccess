Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Static order pages use client-side authenticated queries.
RewriteRule ^(fr|en)/account/orders/([^/]+)/?$ /$1/account/orders/?id=$2 [R=302,L,QSA,NE]
RewriteRule ^(fr|en)/account/commandes/([^/]+)/?$ /$1/account/orders/?order=$2 [R=302,L,QSA,NE]

# Newly published CMS pages stay accessible without rebuilding the export.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(fr|en)/([a-zA-Z0-9_-]+)/?$ /$1/pages/?slug=$2 [R=302,L,QSA,NE]
